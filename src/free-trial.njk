---
layout: layout.njk
title: Free Trial Class
permalink: /free-trial/
description: Book a free trial kung fu class at Shaolin Hung Gar Kung Fu — no experience needed.
---

{% set sections = [
  {
    "type": "page_title",
    "eyebrow": "Get Started",
    "heading": "Free Trial Class",
    "subheading": "Your first class is on us — no experience or equipment needed."
  }
] %}
{% for section in sections %}
  {% include "custom-section.njk" %}
{% endfor %}

<section class="section form-page-section">
  <div class="wrap">
    <div class="form-page">
      <form
        class="js-form"
        action="{{ forms.endpoint }}"
        method="POST"
        data-form-type="free-trial"
        data-thanks-url="{{ '/thanks/' | url }}"
        data-phone="{{ site.phone }}"
        novalidate
      >
        <div class="form-status" aria-live="polite"></div>
        <input type="hidden" name="js_enabled" value="0">
        <div class="field field--honeypot">
          <label for="ft-website">Leave this field empty</label>
          <input type="text" id="ft-website" name="website" tabindex="-1" autocomplete="off">
        </div>

        <div class="field">
          <label for="ft-name">Name</label>
          <input type="text" id="ft-name" name="name" required autocomplete="name">
        </div>

        <div class="field">
          <label for="ft-email">Email</label>
          <input type="email" id="ft-email" name="email" required autocomplete="email">
        </div>

        <div class="field">
          <label for="ft-phone">Phone</label>
          <input type="tel" id="ft-phone" name="phone" autocomplete="tel">
        </div>

        <div class="field">
          <label for="ft-details">What are you interested in?</label>
          <textarea id="ft-details" name="details" placeholder="Kung fu classes for myself, my kid, lion dance…"></textarea>
        </div>

        <button class="btn btn--gold form-submit" type="submit">Book My Free Trial</button>
      </form>
    </div>
  </div>
</section>
